<Window x:Class="LyricEcho.Windows.FloatingLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricEcho · متن شناور" Icon="Assets/LyricEcho.ico"
        Width="452" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        PreviewKeyDown="HandleKey">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7547CF"/>
        <SolidColorBrush x:Key="Panel" Color="#151A29"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7F3FF"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="{DynamicResource Panel}" BorderBrush="#626178" BorderThickness="1">
        <Grid Margin="13,10,13,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel Background="Transparent" MouseLeftButtonDown="DragHeader"
                           Cursor="SizeAll" ToolTip="برای جابه‌جایی پنجره بکشید">
                    <Image DockPanel.Dock="Left" Source="Assets/LyricEcho.png" Width="29" Height="29" Margin="0,0,9,0"/>
                    <TextBlock x:Name="TrackTitle" Text="LyricEcho" FontWeight="SemiBold" FontSize="13"
                               Foreground="#DDD8EC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CompactButton" Content="−" ToolTip="حالت جمع‌وجور" AutomationProperties.Name="حالت جمع‌وجور" Click="ToggleCompact"/>
                    <Button Content="×" FontSize="17" ToolTip="بستن پنجره" AutomationProperties.Name="بستن پنجره" Click="CloseOverlay"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#18000000" BorderBrush="#19FFFFFF" BorderThickness="1"
                    Margin="0,8,0,0" CornerRadius="12" Padding="14,10">
                <StackPanel>
                    <Border Height="2" Width="27" CornerRadius="1" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="OriginalLine" Foreground="#FAF7FF" FontSize="22" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="108" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TranslationLine" Foreground="#A5E5DC" FontSize="17" Margin="0,5,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Grid x:Name="Controls" Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Previous" Content="│◀" ToolTip="آهنگ قبلی" AutomationProperties.Name="آهنگ قبلی"/>
                    <Button x:Name="PlayPause" Content="▶" Background="{DynamicResource Accent}" Width="44"
                            ToolTip="پخش / مکث" AutomationProperties.Name="پخش یا مکث"/>
                    <Button x:Name="Next" Content="▶│" ToolTip="آهنگ بعدی" AutomationProperties.Name="آهنگ بعدی"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="هماهنگی" Foreground="#BFBBCD" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="Delay" Content="−" ToolTip="نیم ثانیه تأخیر" AutomationProperties.Name="نیم ثانیه تأخیر"/>
                    <TextBlock x:Name="OffsetText" Foreground="#D9D4E6" FontSize="11" MinWidth="46"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="Advance" Content="+" ToolTip="نیم ثانیه جلوتر" AutomationProperties.Name="نیم ثانیه جلوتر"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
