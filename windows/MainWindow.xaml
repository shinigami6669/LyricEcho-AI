   <TabItem Header="♫  در حال پخش"><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="#292E3B" BorderThickness="1" CornerRadius="14" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="آهنگ فعلی" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="پخش‌کننده را متصل کن یا دستی جست‌وجو کن" FontSize="11" Foreground="#9398AA" Margin="0,4,0,8" TextWrapping="Wrap"/>
