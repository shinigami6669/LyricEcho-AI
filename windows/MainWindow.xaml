      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Original}" Foreground="#F0EFF8" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" FlowDirection="LeftToRight"/><TextBlock Text="{Binding Translation}" FontSize="15" Foreground="#93C9C4" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox></Border>
     <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="#292E3B" BorderThickness="1" CornerRadius="14" Margin="0,12,0,0" Padding="16,10"><StackPanel><Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="ProgressSlider_MouseUp" FlowDirection="LeftToRight" ToolTip="رفتن به موقعیت آهنگ"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><WrapPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="تنظیم هماهنگی" Foreground="#9398AA" FontSize="11" VerticalAlignment="Center"/><Button Content="−" ToolTip="نیم ثانیه عقب" Click="OffsetMinus_Click" Background="#252B3A" Padding="10,4"/><TextBlock x:Name="OffsetLabel" VerticalAlignment="Center" Text="۰ ثانیه" FontSize="11" Foreground="#C5C4D2" Margin="5"/><Button Content="+" ToolTip="نیم ثانیه جلو" Click="OffsetPlus_Click" Background="#252B3A" Padding="10,4"/></WrapPanel><StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight"><Button Content="‹‹" ToolTip="آهنگ قبلی" Click="Previous_Click" Background="#252B3A"/><Button Content="−5" ToolTip="پنج ثانیه عقب" Click="SeekBack_Click" Background="#252B3A"/><Button Content="▶ / Ⅱ" ToolTip="پخش / مکث" Click="PlayPause_Click" Padding="18,9"/><Button Content="+5" ToolTip="پنج ثانیه جلو" Click="SeekForward_Click" Background="#252B3A"/><Button Content="››" ToolTip="آهنگ بعدی" Click="Next_Click" Background="#252B3A"/></StackPanel></Grid></StackPanel></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="کتابخانه"><Grid Margin="12,20,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
