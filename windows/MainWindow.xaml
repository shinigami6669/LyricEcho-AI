  <TextBlock Grid.Row="2" x:Name="PlaybackStatus" Text="برای شروع، آهنگی پخش کنید یا نام آن را دستی وارد کنید." Foreground="#8D93A5" Margin="4,14,4,0" FontSize="11" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>

