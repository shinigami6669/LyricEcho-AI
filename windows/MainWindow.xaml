      <Button Content="جست‌وجوی متن  ←" Click="Fetch_Click" HorizontalAlignment="Stretch" Margin="0,8,0,3"/><Button Content="شناسایی مجدد" Click="Detect_Click" Background="#252B3A" HorizontalAlignment="Stretch" Margin="0,3"/>
