   <TabItem Header="عیب‌یابی"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="رویدادهای برنامه" FontSize="22" FontWeight="Bold"/><TextBox x:Name="DiagnosticsText" Grid.Row="1" Margin="0,15" Background="#0B0F19" Foreground="#9BDDD5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"/><Button Grid.Row="2" Content="پاک کردن گزارش" Click="ClearLog_Click" HorizontalAlignment="Right" Background="#29334A"/></Grid></TabItem>
