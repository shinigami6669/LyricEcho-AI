     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="card" Background="#1C2231" CornerRadius="9" Margin="0,3" Padding="13,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#303449"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="Background" Value="#453864"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="9" Background="#34304E" Margin="0,0,12,0"><TextBlock Text="♫" Foreground="#C5B3FF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#A6B1C8" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Language}" Foreground="#8BE0D7" Margin="10,0"/><TextBlock Text="★" Visibility="{Binding Favorite, Converter={StaticResource BoolVisibility}}" Foreground="#F6C95C"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox></Border><WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="باز کردن آهنگ" Click="LibraryOpen_Click"/><Button Content="به‌روزرسانی" Click="LibraryRefresh_Click" Background="#29334A"/><Button Content="☆ علاقه‌مندی" Click="FavoriteLibrary_Click" Background="#29334A"/><Button Content="حذف آهنگ" Click="DeleteLibrary_Click" Background="#733B4F"/></WrapPanel></Grid></TabItem>
   <TabItem Header="تنظیمات"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Stretch"><TextBlock Text="ظاهر و تجربه" FontSize="23" FontWeight="Bold"/><TextBlock Text="تم" Margin="0,12,0,0"/><ComboBox x:Name="ThemeChoice" Margin="4" SelectionChanged="ThemeChoice_SelectionChanged"><ComboBoxItem Content="Neon Violet"/><ComboBoxItem Content="Ocean Cyan"/><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Sunset Rose"/><ComboBoxItem Content="Amber"/></ComboBox><WrapPanel><CheckBox x:Name="AutoScroll" Content="حرکت خودکار متن" IsChecked="True" Foreground="White" Margin="6"/><CheckBox x:Name="AutoOverlay" IsChecked="True" Checked="AutoOverlay_Changed" Unchecked="AutoOverlay_Changed" Content="نمایش خودکار پنجره شناور" Foreground="White" Margin="6"/><CheckBox x:Name="AutoTranslate" IsChecked="True" Checked="AutoTranslate_Changed" Unchecked="AutoTranslate_Changed" Content="ترجمه خودکار (مصرف API)" Foreground="White" Margin="6"/><CheckBox x:Name="TrackingEnabled" Content="تشخیص خودکار پخش" IsChecked="True" Foreground="White" Margin="6"/></WrapPanel><TextBlock Text="اندازه متن" Margin="0,10,0,0"/><Slider x:Name="FontSizeSlider" Minimum="13" Maximum="28" Value="18" ValueChanged="FontSizeSlider_ValueChanged"/><TextBlock Text="شفافیت پنجره شناور" Margin="0,10,0,0"/><Slider x:Name="OverlayOpacity" Minimum="0.35" Maximum="1" Value="1" ValueChanged="OverlayOpacity_ValueChanged"/><TextBlock Text="تنظیمات ترجمه" FontSize="23" FontWeight="Bold" Margin="0,22,0,0"/><TextBlock Text="سرویس‌های آماده" Margin="0,12,0,0"/><ComboBox x:Name="ProviderChoice" Margin="4" SelectionChanged="ProviderChoice_SelectionChanged"><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="OpenRouter"/><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="Groq"/><ComboBoxItem Content="Ollama"/><ComboBoxItem Content="سفارشی"/></ComboBox><TextBlock Text="پروفایل‌های API" Margin="0,18,0,0"/><WrapPanel><TextBox x:Name="ProfileName" Width="170" ToolTip="نام پروفایل"/><ComboBox x:Name="ProfileChoice" Width="200" Margin="4"/><Button Content="ذخیره پروفایل" Click="SaveProfile_Click" Background="#29334A"/><Button Content="فعال‌سازی" Click="LoadProfile_Click" Background="#29334A"/><Button Content="حذف" Click="DeleteProfile_Click" Background="#733B4F"/></WrapPanel><TextBlock Text="زبان مقصد" Margin="0,18,0,0"/><ComboBox x:Name="LanguageInput" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="LanguageInput_SelectionChanged"><ComboBoxItem Content="فارسی" Tag="Persian"/><ComboBoxItem Content="English" Tag="English"/><ComboBoxItem Content="العربية" Tag="Arabic"/><ComboBoxItem Content="Español" Tag="Spanish"/><ComboBoxItem Content="Français" Tag="French"/><ComboBoxItem Content="Deutsch" Tag="German"/><ComboBoxItem Content="日本語" Tag="Japanese"/><ComboBoxItem Content="한국어" Tag="Korean"/><ComboBoxItem Content="中文" Tag="Chinese"/><ComboBoxItem Content="Türkçe" Tag="Turkish"/><ComboBoxItem Content="Русский" Tag="Russian"/><ComboBoxItem Content="Italiano" Tag="Italian"/><ComboBoxItem Content="Português" Tag="Portuguese"/><ComboBoxItem Content="हिन्दी" Tag="Hindi"/></ComboBox><TextBlock Text="آدرس Gemini یا API سازگار با OpenAI" Margin="0,12,0,0"/><TextBox x:Name="EndpointInput" Text="https://generativelanguage.googleapis.com" FlowDirection="LeftToRight"/><TextBlock Text="مدل" Margin="0,12,0,0"/><ComboBox x:Name="ModelInput" FlowDirection="LeftToRight"/><WrapPanel><TextBox x:Name="CustomModelInput" Width="280" ToolTip="نام مدل سفارشی" FlowDirection="LeftToRight"/><Button Content="افزودن مدل سفارشی" Click="AddCustomModel_Click" Background="#29334A"/></WrapPanel><TextBlock Text="کلید API" Margin="0,12,0,0"/><PasswordBox x:Name="ApiKey" Margin="4" Padding="9"/><WrapPanel Margin="0,12"><Button Content="ذخیره تنظیمات و کلید" Click="SaveKey_Click"/><Button Content="بازگردانی Gemini" Click="GeminiDefaults_Click" Background="#29334A"/><Button Content="بررسی اتصال و مدل‌ها" Click="TestApi_Click" 