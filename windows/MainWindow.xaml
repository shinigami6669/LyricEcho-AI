      <Border Height="1" Background="#303543" Margin="0,8"/><TextBlock Text="ابزارها" Foreground="#A6A9B8" FontSize="11" Margin="0,0,0,7"/><Button Content="پنجره شناور  ↗" Click="Overlay_Click" Background="#214C52" Margin="0,3"/><WrapPanel><Button Content="فایل LRC / متن" Click="Open_Click" Background="#252B3A"/><Button Content="ورود دستی" Click="Manual_Click" Background="#252B3A"/></WrapPanel>
    </StackPanel></ScrollViewer></Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
