 </Window.Resources>
 <Grid Margin="28,22,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18" LastChildFill="False"><StackPanel DockPanel.Dock="Right" FlowDirection="LeftToRight" Orientation="Horizontal"><Image Source="Assets/LyricEcho.png" Width="38" Height="38" Margin="0,0,9,0"/><StackPanel><TextBlock FontSize="23" FontWeight="Bold" Foreground="#E6DEFF"><Run Text="lyric"/><Run Text="echo" Foreground="#AD94FF"/></TextBlock><TextBlock Text="MUSIC, IN YOUR WORDS" FontSize="9" FontWeight="SemiBold" Foreground="#777D90" Margin="1,2,0,0"/></StackPanel></StackPanel><Border DockPanel.Dock="Left" Background="#17232B" CornerRadius="8" Padding="12,8" MaxWidth="370" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#69D3B3" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="آماده" Foreground="#9ACDC3" TextTrimming="CharacterEllipsis" MaxWidth="320"/></StackPanel></Border></DockPanel>
